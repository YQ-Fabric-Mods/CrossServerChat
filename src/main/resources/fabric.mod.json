{
	"schemaVersion": 1,
	"id": "crossserverchat",
	"version": "${version}",
	"name": "CrossServerChat",
	"description": "A simple server-only chat bridge between Minecraft servers.",
	"authors": [
		"github.com/YQ-Fabric-Mods"
	],
	"license": "MIT",
	"environment": "server",
	"entrypoints": {
		"server": [
			"dev.crossserverchat.CrossServerChatMod"
		]
	},
	"mixins": [
		"crossserverchat.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": ">=${fabric_api_version}",
		"adventure-platform-fabric": ">=${adventure_platform_version}"
	}
}
